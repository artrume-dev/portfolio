{
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/", "dest": "/portfolio/index.html" },
    { "src": "/cv/?", "dest": "/portfolio/cv.html" },
    { "src": "/case-studies/([a-z0-9-]+)/?", "dest": "/portfolio/case-studies/$1.html" },
    { "src": "/ai-portfolio/?", "dest": "/ai-portfolio.html" },
    { "src": "/ai-champion/?", "dest": "/ai-champion.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/portfolio/index.html" }
  ]
}
